# Copiar este archivo como backend/.env y completar los valores reales.
# El .env NUNCA se sube a git (está en .gitignore).

# ── Servidor ──────────────────────────────────────────────
PORT=3000
# Carpeta donde se guardan PDFs, KMZ y fotos (default: <repo>/storage)
# STORAGE_DIR=C:\kumagro\storage

# ── PostgreSQL ────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=kumagro
PGUSER=kumagro
PGPASSWORD=CAMBIAR_ESTA_CLAVE

# ── Adobe Acrobat Sign ────────────────────────────────────
# Integration Key: Acrobat Sign → Cuenta → Adobe Sign API →
#   Información de API → Integration Key (crear con scopes:
#   agreement_read, agreement_write, agreement_send).
ADOBE_SIGN_TOKEN=
# Shard de tu cuenta (ver GET /baseUris o la URL con la que entrás a
# Acrobat Sign): ej. https://api.na1.adobesign.com / https://api.eu1.adobesign.com
ADOBE_SIGN_BASE_URI=
# Cada cuántos minutos consultar el estado de las firmas pendientes
POLL_MINUTOS=10

# ── PDF (opcional) ────────────────────────────────────────
# Si puppeteer no puede descargar Chromium, apuntar a un Chrome ya instalado:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
